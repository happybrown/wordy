<?xml version="1.0" encoding="utf-8"?>
<!--
  런처 아이콘 전경.

  108dp 캔버스에서 기기가 원·둥근사각형으로 잘라내므로 보장되는 곳은 가운데
  66dp(=21~87)뿐이다.

  도형을 중심(54,54) 기준 0.85배로 줄였다. 이전에는 안전 영역을 거의 꽉
  채워 다른 앱 아이콘들 사이에서 유독 커 보였다. 반지름과 획 굵기도 같은
  비율로 줄여 곡률과 선 두께가 도형에 비례하도록 했다.

  말풍선 안의 W 하나. 처음엔 W 를 두 개 겹쳤더니 작은 크기에서 지그재그로
  뭉개져 글자로 안 읽혔고, 그다음엔 W 가 작아 말풍선에 파묻혔다.
  말풍선을 납작하게 눌러 위아래 여백을 줄이고 W 를 키워 균형을 맞췄다.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 말풍선. 가로로 넓고 세로로 납작하게 해서 W 가 들어갈 자리를 확보한다. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M39.5,34.5
                          L68.5,34.5
                          A11,11 0 0 1 79.5,45.5
                          L79.5,59.1
                          A11,11 0 0 1 68.5,70.2
                          L59.1,70.2
                          L48.9,77
                          L50.6,70.2
                          L39.5,70.2
                          A11,11 0 0 1 28.5,59.1
                          L28.5,45.5
                          A11,11 0 0 1 39.5,34.5 Z" />

    <!-- W. 말풍선 폭을 거의 채우도록 키웠다. -->
    <path
        android:strokeColor="#6D5AE0"
        android:strokeWidth="6.8"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M38.7,44.6 L44.6,60.8 L54,49.8 L63.4,60.8 L69.3,44.6" />
</vector>
