<?xml version="1.0" encoding="utf-8"?>
<!--
  런처 아이콘 전경.

  108dp 캔버스에서 기기가 원·둥근사각형으로 잘라내므로 보장되는 곳은 가운데
  66dp(=21~87)뿐이다. 원형 마스크를 감안해 30~78 안에 넣었다.

  말풍선 안의 W 하나. 처음엔 W 를 두 개 겹쳤더니 작은 크기에서 지그재그로
  뭉개져 글자로 안 읽혔고, 그다음엔 W 가 작아 말풍선에 파묻혔다.
  말풍선을 납작하게 눌러 위아래 여백을 줄이고 W 를 키워 균형을 맞췄다.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 말풍선. 가로로 넓고 세로로 납작하게 해서 W 가 들어갈 자리를 확보한다. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M37,31
                          L71,31
                          A13,13 0 0 1 84,44
                          L84,60
                          A13,13 0 0 1 71,73
                          L60,73
                          L48,81
                          L50,73
                          L37,73
                          A13,13 0 0 1 24,60
                          L24,44
                          A13,13 0 0 1 37,31 Z" />

    <!-- W. 말풍선 폭을 거의 채우도록 키웠다. -->
    <path
        android:strokeColor="#C0568E"
        android:strokeWidth="8"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M36,43 L43,62 L54,49 L65,62 L72,43" />
</vector>
